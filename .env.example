# =============================================================================
# StreamEditor AI — Environment Configuration Template
# Copy this file to .env and fill in values for your environment.
# NEVER commit .env — only .env.example is tracked.
# =============================================================================

# Database
DATABASE_URL=postgresql+asyncpg://streameditor:streameditor@localhost:5432/streameditor
DATABASE_URL_SYNC=postgresql://streameditor:streameditor@localhost:5432/streameditor

# Redis
REDIS_URL=redis://localhost:6379/0

# Storage
DATA_DIR=./data

# Model Provider (mock | gemini | anthropic)
# Use 'mock' for local development without API keys.
MODEL_PROVIDER=mock

# API Keys (only set if using real providers)
# GEMINI_API_KEY=
# ANTHROPIC_API_KEY=

# API Config
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=["http://localhost:3000"]
LOG_LEVEL=INFO

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000

# Worker
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# Media Processing
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
ANALYSIS_PROXY_WIDTH=1280
AUDIO_SAMPLE_RATE=16000
CHUNK_SIZE_MINUTES=15
CHUNK_OVERLAP_SECONDS=30
