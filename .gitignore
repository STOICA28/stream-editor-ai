# =============================================================================
# StreamEditor AI — .gitignore
# =============================================================================

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.venv/
dist/
build/
*.egg-info/
*.egg
MANIFEST
pip-wheel-metadata/

# NOTE: uv.lock IS committed (reproducible installs)
# NOTE: alembic/versions/ IS committed (migration history)

# Node / Next.js
node_modules/
.next/
out/
.turbo/
.cache/
*.tsbuildinfo

# Data directory (large files, generated artifacts)
# NOTE: data/.gitkeep is committed so the directory exists
/data/

# Media artifacts (NOT in tests/fixtures/ — those are synthetic test assets)
*.mp4
*.mov
*.avi
*.mkv
*.wav
*.mp3
*.aac
*.flac
*.webm
!tests/fixtures/*.mp4
!tests/fixtures/*.mov
!tests/fixtures/*.avi
!tests/fixtures/*.mkv
!tests/fixtures/*.wav
!tests/fixtures/*.mp3

# Environment files
# NOTE: .env.example IS committed
.env
.env.local
.env.*.local
!.env.example

# Obsidian local config (workspace state is per-machine)
# NOTE: vault config files (.obsidian/*.json other than workspace.json) ARE committed
knowledge-vault/.obsidian/workspace.json
knowledge-vault/.obsidian/workspace-mobile.json
knowledge-vault/.obsidian/cache

# IDE
.vscode/settings.json
.vscode/launch.json
.vscode/*.code-workspace
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Logs
*.log
logs/
*.log.*

# Test artifacts
.pytest_cache/
.mypy_cache/
htmlcov/
.coverage
.coverage.*
coverage.xml
*.cover

# Temporary / scratch
*.tmp
*.bak
*.orig
scratch/
tmp/
*.db
*.sqlite
*.sqlite3
*.rdb
audit_frames/
audit_frames_v2/
cache/